# 本项目所有服务（应用 + 监控）都在这一个文件里
# 监控服务用 profiles 控制，默认不启动，第 3 章会讲

services:
  # ==================== 数据库 ====================
  db:
    image: mysql:8.0
    container_name: wp_db
    restart: unless-stopped
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --max-connections=200
    environment:
      MYSQL_DATABASE: ${MYSQL_DATABASE}
      MYSQL_USER: ${MYSQL_USER}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      TZ: Asia/Shanghai
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      # 用 mysql 客户端真连一次库，比 mysqladmin ping 可靠（见下方说明）
      test:
        - CMD-SHELL
        - mysql -h 127.0.0.1 -u root -p"$$MYSQL_ROOT_PASSWORD" -e "SELECT 1" >/dev/null 2>&1
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 40s
    networks:
      - ops-net
    mem_limit: 1200m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ==================== 应用（PHP-FPM） ====================
  wordpress:
    image: wordpress:6-fpm
    container_name: wp_app
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_USER: ${MYSQL_USER}
      WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}
      WORDPRESS_DB_NAME: ${MYSQL_DATABASE}
      TZ: Asia/Shanghai
      # 追加到 wp-config.php 的额外配置
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', 'https://${DOMAIN}');
        define('WP_SITEURL', 'https://${DOMAIN}');
        define('DISALLOW_FILE_EDIT', true);
        define('WP_MEMORY_LIMIT', '128M');
    volumes:
      - wp_data:/var/www/html
      # php.ini 配置文件挂载到容器里，覆盖默认配置，便于修改上传文件大小
      - ./php.ini:/usr/local/etc/php/conf.d/uploads.ini
    healthcheck:
      test:
        - CMD-SHELL
        - "php -r 'exit(@fsockopen(\"127.0.0.1\", 9000) ? 0 : 1);'"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
    networks:
      - ops-net
    mem_limit: 512m
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # ==================== Web 入口 ====================
  nginx:
    image: nginx:stable
    container_name: wp_nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      # 只读挂载网站文件：Nginx 只需读，不需要写
      - wp_data:/var/www/html:ro
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      # Let's Encrypt 验证目录（宿主机 certbot 写，容器读）
      - ./certbot/www:/var/www/certbot:ro
      # 证书目录（宿主机 certbot 写，容器读）
            # 改成宿主机真实证书目录：certbot 续期后容器直接看到新证书，不用复制
      - /etc/letsencrypt:/etc/letsencrypt:ro
      # 日志挂到宿主机，方便排查和做日志轮转
      - ./logs/nginx:/var/log/nginx
    depends_on:
      - wordpress
    networks:
      - ops-net
    mem_limit: 128m
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  ops-net:
    name: ops-net
    driver: bridge

volumes:
  db_data:
  wp_data: