# Maven Wrapper：无扩展名，需单独指定，避免 Windows 检出变 CRLF 破坏 bash 脚本
/mvnw        text eol=lf
# mvnw.cmd 是 Windows 批处理，必须 CRLF
/mvnw.cmd    text eol=crlf
*.sql        text eol=lf

# ---------- 常见点文件与构建文件 ----------
