.gitignore     text eol=lf
.gitmodules    text eol=lf
.env           text eol=lf
.env.*         text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf
Makefile       text eol=lf
*.mk           text eol=lf
CMakeLists.txt text eol=lf
*.cmake        text eol=lf

